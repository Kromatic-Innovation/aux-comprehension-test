{
  "name": "aux-comprehension-test",
  "version": "0.2.4",
  "description": "Blind, cross-model comprehension test for MCP tool copy: reader models teach back a tools/list payload, route realistic requests, and report confusion; graded against author-written ground truth into a cut-list and a pass/conditional/fail verdict.",
  "license": "Apache-2.0",
  "author": "Kromatic",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Kromatic-Innovation/aux-comprehension-test.git"
  },
  "homepage": "https://github.com/Kromatic-Innovation/aux-comprehension-test#readme",
  "bugs": {
    "url": "https://github.com/Kromatic-Innovation/aux-comprehension-test/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tool-description",
    "agent-ux",
    "llm",
    "evaluation",
    "cross-model"
  ],
  "type": "module",
  "bin": {
    "aux-comprehension-test": "bin/aux-comprehension-test.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./internal": "./src/internal.mjs"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "personas",
    "data",
    "examples",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "panelist": ">=0.4.2"
  },
  "engines": {
    "node": ">=20"
  }
}
